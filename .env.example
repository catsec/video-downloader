# Application settings (all optional — sensible defaults are baked in).
MAX_FILE_AGE_SECONDS=3600
MAX_FILE_SIZE_MB=500
YTDLP_UPDATE_CHECK_INTERVAL=600
POST_SERVE_DELETE_DELAY=300

# NOTE: the Cloudflare tunnel is no longer part of this stack. cloudflared runs as
# its own compose (TUNNEL_TOKEN lives in that stack's .env) and reaches this app over
# the shared `edge` network. See CLAUDE.md "Deployment".
